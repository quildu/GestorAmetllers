# Copia aquest fitxer a .env i edita els valors abans de fer 'docker compose up'

# Ruta de la base de dades dins el contenidor (no cal tocar-la normalment)
DB_PATH=db/farm.db

# Ruta on es guarden els documents adjunts (fotos, factures, etc.) dins el contenidor
DOCUMENTS_PATH=documents

# Clau secreta per signar les sessions. Genera'n una amb:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=canvia-aquesta-clau-per-una-aleatoria

# Credencials d'accés a l'aplicació (aquest usuari pot crear parcel·les noves)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=canvia-aquesta-contrasenya

# Segon usuari opcional, sense permisos per crear parcel·les.
# Si deixes aquestes dues linies buides o comentades, nomes existira l'usuari admin.
USER_USERNAME=treballador
USER_PASSWORD=canvia-aquesta-altra-contrasenya

# Adreça del lloc per Caddy.
# - Sense domini encara: deixa "http://:80" (accés per IP, sense TLS)
# - Amb domini apuntant al servidor (registre DNS tipus A -> IP del servidor): posa "elteudomini.com"
#   Caddy genera i renova el certificat HTTPS automaticament via Let's Encrypt.
SITE_ADDRESS=http://:80

# Avisos de reg per Telegram (comprovació diària del cabal per sector)
# 1. Parla amb @BotFather a Telegram, envia /newbot i copia el token aquí.
# 2. Envia qualsevol missatge al teu bot i obre https://api.telegram.org/bot<TOKEN>/getUpdates
#    per veure el "chat":{"id":...}. Pots posar-ne diversos separats per comes (p.ex. els dos germans).
# 3. Prova-ho amb: python scripts/check_irrigation.py --test-telegram
TELEGRAM_BOT_TOKEN=8760193080:AAGzvJV8MsoiSj6-AaLiufU_qvArk16lTcg
TELEGRAM_CHAT_IDS=

# Credencials de Vegga (app.veggadigital.com) per llegir programes i l'historial de reg
VEGGA_EMAIL=
VEGGA_PASSWORD=
